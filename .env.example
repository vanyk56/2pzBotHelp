# Скопируйте этот файл в .env и заполните. .env не попадает в git.

# --- Discord ---
DISCORD_TOKEN=
# ID сервера (2pz - community)
GUILD_ID=
# Канал, где висит закреплённая кнопка «Подать тикет»
PANEL_CHANNEL_ID=
# Категория «заявка в клан, тикеты», в ней создаются каналы заявок
TICKET_CATEGORY_ID=
# Роли модерации через запятую (Owner, Co-owner, Moderator): их пингуем и даём права
STAFF_ROLE_IDS=
# Второй канал с кнопками коллера, медиа клана и модератора. Необязательно
SECONDARY_PANEL_CHANNEL_ID=
# Голосовой канал для обзвона (•CHECKING). Необязательно
VOICE_CHANNEL_ID=

# --- Neon (Postgres) ---
# Строка подключения из консоли Neon, с sslmode=require
DATABASE_URL=

# --- ИИ (River) ---
RIVER_API_KEY=
RIVER_BASE_URL=https://api.river.ai/v1
AI_MODEL=zai-org/GLM-5.3-Flash
# Сколько последних сообщений тикета отправлять модели как память
AI_CONTEXT_MESSAGES=30
AI_MAX_TOKENS=700
