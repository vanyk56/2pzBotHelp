# Скопируйте этот файл в .env и заполните. .env не попадает в git.
# Серверы Discord (ID каналов, категорий и ролей) настраиваются в config/servers.json.

# --- Discord ---
DISCORD_TOKEN=

# --- Neon (Postgres) ---
# Строка подключения из консоли Neon, с sslmode=require
DATABASE_URL=

# --- ИИ (River) ---
RIVER_API_KEY=
RIVER_BASE_URL=https://api.river.ai/v1
AI_MODEL=zai-org/GLM-5.3-Flash
# Сколько последних сообщений тикета отправлять модели как память
AI_CONTEXT_MESSAGES=30
AI_MAX_TOKENS=700
